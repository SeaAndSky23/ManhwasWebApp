@model ManhwasWebApp.Models.VwDetalleManhwa

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Manhwa</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.TituloPrincipal)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.TituloPrincipal)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Autores)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Autores)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Generos)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Generos)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Etiquetas)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Etiquetas)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Novela)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Novela)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Sinopsis)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Sinopsis)</dd>

        <dt class="col-sm-2">Portada</dt>
        <dd class="col-sm-10">
            <img src="@(string.IsNullOrEmpty(Model.UrlPortada) ? "/images/no-cover.png" : Model.UrlPortada)"
                 alt="Portada de @Model.TituloPrincipal"
                 style="max-width:220px; max-height:320px; object-fit:cover;"
                 class="border rounded shadow-sm" />
        </dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Calificacion)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Calificacion)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Estado)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Estado)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.AnioPublicacion)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.AnioPublicacion)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.NumeroCapitulos)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.NumeroCapitulos)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.AnioFinalizacion)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.AnioFinalizacion)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.IdManhwa">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>