@model IEnumerable<ManhwasWebApp.Models.VwDetalleManhwa>

@{
    ViewData["Title"] = "Mis Manhwas";
}

<header class="header">
    <h1>Mis Manhwas</h1>
    <a asp-action="Create" class="btn-agregar">+ AÑADIR</a>
</header>

<section class="filtros">
    <form asp-action="Index" method="get" class="filtros-form">
        <input type="text"
               name="busqueda"
               placeholder="buscar por título o autor"
               class="buscador"
               value="@ViewBag.Busqueda" />

        <select name="generoId" onchange="this.form.submit()">
            <option value="">todos los géneros</option>
            @foreach (var genero in (List<ManhwasWebApp.Models.Genero>)ViewBag.Generos)
            {
                <option value="@genero.IdGenero" selected="@(ViewBag.GeneroId == genero.IdGenero)">
                    @genero.Nombre
                </option>
            }
        </select>

        <select name="etiquetaId" onchange="this.form.submit()">
            <option value="">todas las etiquetas</option>
            @foreach (var etiqueta in (List<ManhwasWebApp.Models.Etiquetum>)ViewBag.Etiquetas)
            {
                <option value="@etiqueta.IdEtiqueta" selected="@(ViewBag.EtiquetaId == etiqueta.IdEtiqueta)">
                    @etiqueta.Nombre
                </option>
            }
        </select>

        <select name="orden" onchange="this.form.submit()">
            <option value="">ordenar por</option>
            <option value="titulo" selected="@(ViewBag.Orden == "titulo")">Título</option>
            <option value="calificacion" selected="@(ViewBag.Orden == "calificacion")">Calificación</option>
            <option value="anio" selected="@(ViewBag.Orden == "anio")">Año</option>
        </select>

        <noscript><button type="submit" class="btn-buscar">Buscar</button></noscript>
    </form>
</section>

<main class="contenedor-manhwas">
    @foreach (var item in Model)
    {
        string claseEstado = item.Estado switch
        {
            "En emision" => "estado-emision",
            "Pausado" => "estado-pausa",
            "Finalizado" => "estado-finalizado",
            _ => ""
        };

        <article class="card">
            <a asp-action="Details" asp-route-id="@item.IdManhwa">
                <img src="@(string.IsNullOrEmpty(item.UrlPortada) ? "/images/no-cover.png" : item.UrlPortada)"
                     alt="@item.TituloPrincipal">
            </a>
            <h2>@item.TituloPrincipal</h2>
            <span class="estado @claseEstado">@item.Estado</span>

            <div class="calificacion">
                @{
                    int estrellas = (int)Math.Round((item.Calificacion ?? 0) / 2);
                }
                <span class="estrellas">@(new string('★', estrellas))@(new string('☆', 5 - estrellas))</span>
                <span>@(item.Calificacion?.ToString("00.00") ?? "00.00")</span>
            </div>

            <p>@item.NumeroCapitulos capítulos</p>
            <p>@item.Generos</p>

            <div class="etiquetas">
                @foreach (var etq in (item.Etiquetas ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                {
                    <span>@etq</span>
                }
            </div>

            <div class="acciones">
                <a asp-action="Edit" asp-route-id="@item.IdManhwa">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.IdManhwa">Eliminar</a>
            </div>
        </article>
    }
    }
</main>