@model IEnumerable<ManhwasWebApp.Models.VwDetalleManhwa>

@{
    ViewData["Title"] = "Mis Manhwas";
}

<h1 class="mb-4">📚 Mis Manhwas</h1>

<p>
    <a asp-controller="Manhwas" asp-action="Create" class="btn btn-primary">+ Agregar Manhwa</a>
</p>

<div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
    @foreach (var item in Model)
    {
        string badgeClass = item.Estado switch
        {
            "Finalizado" => "bg-success",
            "En emision" => "bg-primary",
            "Pausado" => "bg-warning text-dark",
            "Cancelado" => "bg-danger",
            _ => "bg-secondary"
        };

        <div class="col">
            <div class="card h-100 shadow-sm">
                <a asp-controller="Manhwas" asp-action="Details" asp-route-id="@item.IdManhwa">
                    <img src="@(string.IsNullOrEmpty(item.UrlPortada) ? "/images/no-cover.png" : item.UrlPortada)"
                         class="card-img-top" alt="Portada" style="height:280px; object-fit:cover;" />
                </a>
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">
                        <a asp-controller="Manhwas" asp-action="Details" asp-route-id="@item.IdManhwa" class="text-decoration-none text-dark">
                            @item.TituloPrincipal
                        </a>
                    </h5>
                    <span class="badge @badgeClass mb-2" style="width:fit-content;">@item.Estado</span>

                    <p class="text-warning mb-1">
                        @{
                            int estrellas = (int)Math.Round((item.Calificacion ?? 0) / 2);
                        }
                        @for (int i = 0; i < 5; i++)
                        {
                            <span>@(i < estrellas ? "★" : "☆")</span>
                        }
                        <span class="text-muted small">(@item.Calificacion)</span>
                    </p>

                    <p class="small text-muted mb-2">✍️ @item.Autores</p>
                    <p class="small text-muted">📖 @item.NumeroCapitulos capítulos</p>
                    @if (!string.IsNullOrEmpty(item.Generos) && item.Generos != "Sin género registrado")
                    {
                        <p class="small text-muted mb-0">🏷️ @item.Generos</p>
                    }

                    <div class="mt-auto d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@item.IdManhwa" class="btn btn-sm btn-outline-secondary">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.IdManhwa" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>