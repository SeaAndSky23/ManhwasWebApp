@model ManhwasWebApp.Models.ManhwaEditViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Manhwa</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdManhwa" />
            <input type="hidden" asp-for="UrlPortadaActual" />

            @if (!string.IsNullOrEmpty(Model.UrlPortadaActual))
            {
                <div class="form-group">
                    <label class="control-label d-block">Portada actual</label>
                    <img src="@Model.UrlPortadaActual" alt="Portada actual" style="max-width:150px; max-height:220px; object-fit:cover;" class="mb-2 border rounded" />
                </div>
            }

            <div class="form-group form-check">
                <input asp-for="Novela" class="form-check-input" />
                <label asp-for="Novela" class="form-check-label"></label>
                <span asp-validation-for="Novela" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Sinopsis" class="control-label"></label>
                <textarea asp-for="Sinopsis" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Sinopsis" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PortadaFile" class="control-label">Reemplazar portada</label>
                <input asp-for="PortadaFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                <span asp-validation-for="PortadaFile" class="text-danger"></span>
                <small class="form-text text-muted">Déjalo vacío para conservar la portada actual.</small>
            </div>
            <div class="form-group">
                <label asp-for="Calificacion" class="control-label"></label>
                <input asp-for="Calificacion" class="form-control" />
                <span asp-validation-for="Calificacion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Estado" class="control-label"></label>
                <select asp-for="Estado" class="form-control">
                    <option value="">-- Selecciona un estado --</option>
                    <option value="En emision">En emisión</option>
                    <option value="Pausado">Pausado</option>
                    <option value="Finalizado">Finalizado</option>
                </select>
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AnioPublicacion" class="control-label"></label>
                <input asp-for="AnioPublicacion" class="form-control" />
                <span asp-validation-for="AnioPublicacion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NumeroCapitulos" class="control-label"></label>
                <input asp-for="NumeroCapitulos" class="form-control" />
                <span asp-validation-for="NumeroCapitulos" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AnioFinalizacion" class="control-label"></label>
                <input asp-for="AnioFinalizacion" class="form-control" />
                <span asp-validation-for="AnioFinalizacion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Géneros</label>
                <div>
                    @foreach (var genero in (List<ManhwasWebApp.Models.Genero>)ViewBag.AllGeneros)
                    {
                        <div class="form-check form-check-inline">
                            <input type="checkbox" class="form-check-input" name="SelectedGeneros" value="@genero.IdGenero" id="genero_@genero.IdGenero"
                                   checked="@(Model.SelectedGeneros.Contains(genero.IdGenero))" />
                            <label class="form-check-label" for="genero_@genero.IdGenero">@genero.Nombre</label>
                        </div>
                    }
                </div>
            </div>
            <div class="form-group">
                <label class="control-label">Etiquetas</label>
                <div>
                    @foreach (var etiqueta in (List<ManhwasWebApp.Models.Etiquetum>)ViewBag.AllEtiquetas)
                    {
                        <div class="form-check form-check-inline">
                            <input type="checkbox" class="form-check-input" name="SelectedEtiquetas" value="@etiqueta.IdEtiqueta" id="etiqueta_@etiqueta.IdEtiqueta"
                                   checked="@(Model.SelectedEtiquetas.Contains(etiqueta.IdEtiqueta))" />
                            <label class="form-check-label" for="etiqueta_@etiqueta.IdEtiqueta">@etiqueta.Nombre</label>
                        </div>
                    }
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}