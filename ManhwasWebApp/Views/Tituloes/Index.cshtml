@model IEnumerable<ManhwasWebApp.Models.Titulo>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Titulo1)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Idioma)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdManhwaNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Titulo1)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Idioma)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdManhwaNavigation.IdManhwa)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdTitulo">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdTitulo">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdTitulo">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
