@model IEnumerable<ManhwasWebApp.Models.ManhwaAutor>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Rol)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdAutorNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdManhwaNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Rol)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdAutorNavigation.IdAutor)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdManhwaNavigation.IdManhwa)
            </td>
                <td>
                    <a asp-action="Edit" asp-route-idManhwa="@item.IdManhwa" asp-route-idAutor="@item.IdAutor">Edit</a> |
                    <a asp-action="Details" asp-route-idManhwa="@item.IdManhwa" asp-route-idAutor="@item.IdAutor">Details</a> |
                    <a asp-action="Delete" asp-route-idManhwa="@item.IdManhwa" asp-route-idAutor="@item.IdAutor">Delete</a>
                </td>
        </tr>
}
    </tbody>
</table>
